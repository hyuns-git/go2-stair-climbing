# go2_nav_bridge email_sender 설정 템플릿
#
# 사용법: 이 파일을 같은 디렉터리에 ".env"로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
#
# 실제 host/port/계정/비밀번호는 사람이 직접 입력할 것 — Claude Code는 이
# 값들을 대신 채우지 않는다 (HANDOFF.md 2/3항 참고). .env 파일 자체를
# git에 커밋하지 말 것 (비밀번호 포함).
#
# 2026-09-11 결정: 회사 SMTP(IT팀 문의) 대신 개인 Gmail SMTP로 진행하기로 함
# (IT 문의 절차 생략, 아웃바운드 587 포트 이슈 회피). Gmail 사용 시 값 예시:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=본인계정@gmail.com
#   SMTP_PASSWORD=앱 비밀번호 16자리 (일반 로그인 비밀번호 아님! 아래 참고)
#   MAIL_FROM=본인계정@gmail.com (SMTP_USER와 동일)
#   MAIL_TO=받을 주소
# 앱 비밀번호는 구글 계정에 2단계 인증을 먼저 켠 뒤
# https://myaccount.google.com/apppasswords 에서 발급받는다
# (일반 비밀번호로는 로그인 안 됨).

# SMTP 서버 주소 (IT팀 문의)
SMTP_HOST=

# SMTP 포트 (STARTTLS면 보통 587, 암시적 TLS(SMTPS)면 보통 465)
SMTP_PORT=

# true = STARTTLS(기본, 587 등) / false = 암시적 TLS(SMTPS, 465 등)
SMTP_USE_TLS=true

# 발송 계정 (회사 메일 계정)
SMTP_USER=

# 발송 계정 비밀번호 (또는 앱 비밀번호)
SMTP_PASSWORD=

# 보내는 사람 표시 주소 (보통 SMTP_USER와 동일)
MAIL_FROM=

# 받는 사람 주소 (여러 명이면 콤마로 구분)
MAIL_TO=

# 옥상 문 열기 주소 (접속만 하면 문이 열림 - 절대 공개 저장소에 올리지 말 것)
MISSION_DOOR_URL=https://example.invalid/trigger
